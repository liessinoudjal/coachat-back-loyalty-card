{% extends 'emails/signup_alert_base.html.twig' %}

{% block email_body %}
    <div style="font-size:20px; font-weight:700; color:#111827; margin-bottom:18px;">Bonjour {{ customer_name }},</div>

    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:#fef3c7; border:1px solid #fcd34d; border-radius:16px; box-shadow:0 1px 4px rgba(17,24,39,0.04); margin-bottom:16px;">
        <tr>
            <td style="padding:8px 20px;">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
                    <tr>
                        <td style="padding:14px 0; border-bottom:1px solid #fde68a; vertical-align:top;">
                            <div style="font-size:12px; text-transform:uppercase; letter-spacing:0.8px; color:#b45309; margin-bottom:6px;">⚠ Changement de permissions</div>
                            <div style="font-size:16px; line-height:1.5; font-weight:600; color:#111827; word-break:break-word;">
                                Votre rôle a été modifié chez {{ merchant_name }}.
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:14px 0; border-bottom:1px solid #fde68a; vertical-align:top;">
                            <div style="font-size:12px; text-transform:uppercase; letter-spacing:0.8px; color:#b45309; margin-bottom:6px;">Nouveau rôle</div>
                            <div style="font-size:16px; line-height:1.5; font-weight:600; color:#111827; word-break:break-word;">
                                Vous êtes maintenant équipier.
                            </div>
                            <div style="font-size:14px; color:#374151; margin-top:10px;">
                                Vous conservez l'accès à votre espace équipier avec les permissions réduites.
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:14px 0; vertical-align:top;">
                            <div style="font-size:12px; text-transform:uppercase; letter-spacing:0.8px; color:#b45309; margin-bottom:6px;">Options disponibles</div>
                            <div style="font-size:16px; line-height:1.5; font-weight:600; color:#111827; word-break:break-word;">
                                Vous conservez l'accès à votre espace équipier pour consulter les informations du commerce.
                            </div>
                            <div style="font-size:14px; color:#374151; margin-top:10px;">
                                Si vous avez des questions, veuillez contacter votre responsable.
                            </div>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin-bottom:16px;">
        <tr>
            <td>
                <a href="{{ dashboard_url }}" style="display:inline-block; background-color:#b45309; color:#ffffff; text-decoration:none; padding:14px 18px; border-radius:12px; font-size:15px; font-weight:700;">Accéder au dashboard</a>
            </td>
        </tr>
    </table>

    <div style="font-size:14px; line-height:1.7; color:#6b7280;">
        Vous pouvez utiliser le sélecteur d'espaces pour basculer entre votre profil client et votre profil équipier.
    </div>
{% endblock %}
