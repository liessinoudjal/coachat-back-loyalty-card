{% extends 'emails/signup_alert_base.html.twig' %}

{% block email_body %}
    <div style="font-size:20px; font-weight:700; color:#111827; margin-bottom:18px;">Bonjour {{ customer.name ?? 'client' }},</div>

    <div style="font-size:15px; line-height:1.7; color:#111827; margin-bottom:14px;">
        Votre participation au jeu concours <strong>{{ contest_title }}</strong> chez {{ merchant.companyName ?? merchant.company_name ?? 'votre commerçant' }} a bien été prise en compte.
    </div>

    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:#ffffff; border:1px solid #e5e7eb; border-radius:16px; box-shadow:0 1px 4px rgba(17,24,39,0.04); margin-bottom:16px;">
        <tr>
            <td style="padding:8px 20px;">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
                    <tr>
                        <td style="padding:14px 0; border-bottom:1px solid #f0f0f0; vertical-align:top;">
                            <div style="font-size:12px; text-transform:uppercase; letter-spacing:0.8px; color:#6b7280; margin-bottom:6px;">Votre compteur</div>
                            <div style="font-size:15px; line-height:1.7; color:#111827;">
                                {{ participation_count }} participation(s) enregistrée(s) sur {{ participation_limit }} maximum.
                            </div>
                            {% if limit_reached %}
                                <div style="margin-top:8px; font-size:14px; line-height:1.6; color:#991b1b; background:#fef2f2; border:1px solid #fecaca; border-radius:10px; padding:10px 12px;">
                                    Vous avez atteint la limite de {{ participation_limit }} participations pour ce concours. Vos prochains scans continueront à mettre à jour votre carte de fidélité, mais ne créeront plus de participation supplémentaire.
                                </div>
                            {% else %}
                                <div style="margin-top:8px; font-size:14px; line-height:1.6; color:#1d4ed8; background:#eff6ff; border:1px solid #bfdbfe; border-radius:10px; padding:10px 12px;">
                                    Il vous reste {{ participation_limit - participation_count }} participation(s) possible(s) avant d'atteindre la limite.
                                </div>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:14px 0; border-bottom:1px solid #f0f0f0; vertical-align:top;">
                            <div style="font-size:12px; text-transform:uppercase; letter-spacing:0.8px; color:#6b7280; margin-bottom:6px;">Règles du concours</div>
                            <div style="font-size:15px; line-height:1.7; color:#111827; white-space:pre-line;">{{ contest_description }}</div>
                            <div style="font-size:15px; line-height:1.7; color:#111827; margin-top:8px;">
                                Chaque client peut cumuler jusqu'à {{ participation_limit }} participations sur ce concours. Chaque scan valide une participation supplémentaire jusqu'à cette limite.
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:14px 0; border-bottom:1px solid #f0f0f0; vertical-align:top;">
                            <div style="font-size:12px; text-transform:uppercase; letter-spacing:0.8px; color:#6b7280; margin-bottom:6px;">Période</div>
                            <div style="font-size:15px; line-height:1.7; color:#111827;">Du {{ contest_start_at }} au {{ contest_end_at }}</div>
                        </td>
                    </tr>
                    {% if contest_draw_at is defined and contest_draw_at is not empty %}
                        <tr>
                            <td style="padding:14px 0; border-bottom:1px solid #f0f0f0; vertical-align:top;">
                                <div style="font-size:12px; text-transform:uppercase; letter-spacing:0.8px; color:#6b7280; margin-bottom:6px;">Tirage au sort</div>
                                <div style="font-size:15px; line-height:1.7; color:#111827;">{{ contest_draw_at }}</div>
                            </td>
                        </tr>
                    {% endif %}
                    {% if contest_rewards is defined and contest_rewards|length > 0 %}
                        <tr>
                            <td style="padding:14px 0; vertical-align:top;">
                                <div style="font-size:12px; text-transform:uppercase; letter-spacing:0.8px; color:#6b7280; margin-bottom:6px;">Lots à gagner</div>
                                <ul style="margin:0; padding-left:18px; color:#111827; font-size:15px; line-height:1.7;">
                                    {% for reward in contest_rewards %}
                                        <li><strong>{{ reward.order_label }} tirage</strong> : {{ reward.title }}</li>
                                    {% endfor %}
                                </ul>
                            </td>
                        </tr>
                    {% endif %}
                </table>
            </td>
        </tr>
    </table>

    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin-bottom:16px;">
        <tr>
            <td>
                <a href="{{ dashboard_url }}" style="display:inline-block; background-color:#2563eb; color:#ffffff; text-decoration:none; padding:14px 18px; border-radius:12px; font-size:15px; font-weight:700;">Voir mon tableau de bord</a>
            </td>
        </tr>
    </table>

    <div style="margin-top:10px; font-size:13px; line-height:1.6; color:#6b7280;">
        Les règles de participation figurent dans les pages légales acceptées lors de votre utilisation du service.
    </div>
{% endblock %}
