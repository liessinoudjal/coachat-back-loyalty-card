###> Google OAuth ###
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback
###< Google OAuth ###

###> Apple Wallet ###
APPLE_WALLET_CERT_PATH=%kernel.project_dir%/config/wallet/apple/certificate.p12
APPLE_WALLET_CERT_PASSWORD=your_certificate_password
APPLE_WALLET_PASS_TYPE_IDENTIFIER=pass.com.yourcompany.loyaltycard
APPLE_WALLET_TEAM_IDENTIFIER=YOUR_TEAM_ID
APPLE_WALLET_ORGANIZATION_NAME="Your Company Name"
###< Apple Wallet ###

###> Google Wallet ###
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_WALLET_SERVICE_ACCOUNT_KEY_PATH=%kernel.project_dir%/config/wallet/google/service-account-key.json
GOOGLE_WALLET_ISSUER_ID=your_google_wallet_issuer_id
GOOGLE_WALLET_CLASS_SUFFIX=loyalty_card
###< Google Wallet ###

###> App ###
APP_BASE_URL=http://localhost:8000
